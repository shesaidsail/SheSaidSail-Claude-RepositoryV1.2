# ─────────────────────────────────────────────────────────────────────────────
# Weather Market Edge Tracker — environment variables
#
# SETUP:  Copy this file to .env and fill in your real credentials.
#         NEVER paste credentials into source code or commit .env to git.
#
#   cp .env.example .env
#   nano .env   # paste your values
# ─────────────────────────────────────────────────────────────────────────────

# Kalshi REST API credentials
# Get these from:  https://kalshi.com/account/api-credentials
KALSHI_API_KEY=
KALSHI_API_SECRET=

# "demo" uses the demo sandbox (https://demo-api.kalshi.co)
# "prod" uses the live environment (https://trading.kalshi.com)
KALSHI_ENV=demo

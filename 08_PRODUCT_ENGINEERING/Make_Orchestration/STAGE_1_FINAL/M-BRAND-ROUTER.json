{
  "name": "SSS-BRAND-ROUTER",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": "SSS_BRAND_ROUTER_HOOK",
        "maxResults": 1
      },
      "mapper": {},
      "metadata": {
        "designer": { "x": 0, "y": 0 },
        "restore": { "parameters": { "hook": { "label": "SSS Brand Router Webhook" } } }
      }
    },
    {
      "id": 2,
      "module": "builtin:BasicRouter",
      "version": 1,
      "parameters": {},
      "mapper": {},
      "metadata": {
        "designer": { "x": 200, "y": 0 }
      },
      "routes": [
        {
          "filter": {
            "name": "SSS",
            "conditions": [
              [
                {
                  "a": "{{1.source_url}}",
                  "b": "shesaidsail",
                  "o": "text:contain"
                }
              ]
            ]
          },
          "flow": [
            {
              "id": 3,
              "module": "gateway:CustomWebHookRespond",
              "version": 1,
              "parameters": {},
              "mapper": {
                "status": "200",
                "body": "{\"brand\": \"SSS\", \"routing_confidence\": \"HIGH\"}",
                "headers": [{ "name": "Content-Type", "value": "application/json" }]
              },
              "metadata": {
                "designer": { "x": 500, "y": -150 }
              }
            }
          ]
        },
        {
          "filter": {
            "name": "ME",
            "conditions": [
              [
                {
                  "a": "{{1.source_url}}",
                  "b": "mareexecutive",
                  "o": "text:contain"
                }
              ]
            ]
          },
          "flow": [
            {
              "id": 4,
              "module": "gateway:CustomWebHookRespond",
              "version": 1,
              "parameters": {},
              "mapper": {
                "status": "200",
                "body": "{\"brand\": \"ME\", \"routing_confidence\": \"HIGH\"}",
                "headers": [{ "name": "Content-Type", "value": "application/json" }]
              },
              "metadata": {
                "designer": { "x": 500, "y": 0 }
              }
            }
          ]
        },
        {
          "filter": {
            "name": "UNKNOWN",
            "conditions": [
              [
                {
                  "a": "{{1.source_url}}",
                  "b": "shesaidsail",
                  "o": "text:notcontain"
                },
                {
                  "a": "{{1.source_url}}",
                  "b": "mareexecutive",
                  "o": "text:notcontain"
                }
              ]
            ]
          },
          "flow": [
            {
              "id": 5,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": { "handleErrors": false, "useNewZLibDeCompress": true },
              "mapper": {
                "url": "PASTE_SLACK_ALERTS_WEBHOOK_URL_HERE",
                "method": "POST",
                "headers": [{ "name": "Content-Type", "value": "application/json" }],
                "body": "{\"alert_type\": \"OPS\", \"severity\": \"WARNING\", \"title\": \"Brand classification UNKNOWN\", \"body\": \"Source URL could not be classified: {{1.source_url}}. Manual brand assignment needed.\", \"booking_id\": \"N/A\", \"city\": \"Unknown\", \"brand\": \"UNKNOWN\"}"
              },
              "metadata": {
                "designer": { "x": 500, "y": 150 }
              }
            },
            {
              "id": 6,
              "module": "gateway:CustomWebHookRespond",
              "version": 1,
              "parameters": {},
              "mapper": {
                "status": "200",
                "body": "{\"brand\": \"UNKNOWN\", \"routing_confidence\": \"LOW\"}",
                "headers": [{ "name": "Content-Type", "value": "application/json" }]
              },
              "metadata": {
                "designer": { "x": 700, "y": 150 }
              }
            }
          ]
        }
      ]
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    },
    "zone": "us1.make.com",
    "notes": "PLACEHOLDER: replace PASTE_SLACK_ALERTS_WEBHOOK_URL_HERE in module 5 with SSS-SLACK-ALERTS webhook URL. No connections to rebind — no Airtable or Slack OAuth needed. Pure classification: SSS → {brand:SSS}, ME → {brand:ME}, unknown → Slack alert + {brand:UNKNOWN}. Webhook respond is inside each route branch."
  }
}

{
  "name": "SSS-STRIPE-DEPOSIT",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": "SSS_STRIPE_DEPOSIT_HOOK",
        "maxResults": 1
      },
      "mapper": {},
      "metadata": {
        "designer": { "x": 0, "y": 0 },
        "restore": { "parameters": { "hook": { "label": "SSS Stripe Deposit Webhook — register in Stripe Developers → Webhooks" } } }
      }
    },
    {
      "id": 2,
      "module": "airtable:SearchRecords",
      "version": 3,
      "parameters": {
        "base": "appdZ49WqgjRXxA1R",
        "table": "tbl72omPibBkn2hZL",
        "maxRecords": 1
      },
      "mapper": {
        "filterByFormula": "FIND(\"{{1.data.object.metadata.booking_id}}\", {Booking ID})"
      },
      "metadata": {
        "designer": { "x": 200, "y": 0 },
        "restore": {
          "parameters": {
            "base": { "label": "She Said Sail" },
            "table": { "label": "Bookings" }
          }
        }
      }
    },
    {
      "id": 3,
      "module": "builtin:BasicRouter",
      "version": 1,
      "parameters": {},
      "mapper": {},
      "metadata": {
        "designer": { "x": 400, "y": 0 }
      },
      "routes": [
        {
          "filter": {
            "name": "Process deposit",
            "conditions": [
              [
                {
                  "a": "{{1.type}}",
                  "b": "payment_intent.succeeded",
                  "o": "text:equal"
                },
                {
                  "a": "{{2.id}}",
                  "b": "",
                  "o": "text:notempty"
                },
                {
                  "a": "{{2.fields.Status}}",
                  "b": "DEPOSIT_PAID",
                  "o": "text:notequal"
                },
                {
                  "a": "{{2.fields.Environment}}",
                  "b": "Sandbox",
                  "o": "text:notequal"
                }
              ]
            ]
          },
          "flow": [
            {
              "id": 4,
              "module": "airtable:ActionUpdateRecord",
              "version": 3,
              "parameters": {
                "base": "appdZ49WqgjRXxA1R",
                "table": "tbl72omPibBkn2hZL"
              },
              "mapper": {
                "recordId": "{{2.id}}",
                "fields": {
                  "Status": "DEPOSIT_PAID",
                  "Source_System": "Stripe",
                  "Last_Automation_Timestamp": "{{formatDate(now; \"YYYY-MM-DDTHH:mm:ssZ\")}}"
                }
              },
              "metadata": {
                "designer": { "x": 600, "y": 0 },
                "restore": {
                  "parameters": {
                    "base": { "label": "She Said Sail" },
                    "table": { "label": "Bookings" }
                  }
                }
              }
            },
            {
              "id": 5,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": { "handleErrors": false, "useNewZLibDeCompress": true },
              "mapper": {
                "url": "PASTE_SLACK_ALERTS_WEBHOOK_URL_HERE",
                "method": "POST",
                "headers": [{ "name": "Content-Type", "value": "application/json" }],
                "body": "{\"alert_type\": \"OPS\", \"severity\": \"INFO\", \"title\": \"Deposit Received\", \"body\": \"${{divide(1.data.object.amount_received; 100)}} deposit confirmed via Stripe. Booking updated to DEPOSIT_PAID.\", \"booking_id\": \"{{2.fields.Booking ID}}\", \"city\": \"{{2.fields.City}}\", \"brand\": \"{{2.fields.Brand}}\"}"
              },
              "metadata": { "designer": { "x": 800, "y": 0 } }
            },
            {
              "id": 6,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": { "handleErrors": false, "useNewZLibDeCompress": true },
              "mapper": {
                "url": "PASTE_AUDIT_LOGGER_WEBHOOK_URL_HERE",
                "method": "POST",
                "headers": [{ "name": "Content-Type", "value": "application/json" }],
                "body": "{\"triggering_event\": \"Stripe payment_intent.succeeded — deposit\", \"source_data\": \"Payment Intent ID: {{1.data.object.id}}, Amount: ${{divide(1.data.object.amount_received; 100)}} {{1.data.object.currency}}, Customer: {{1.data.object.receipt_email}}\", \"output\": \"Booking {{2.fields.Booking ID}} updated to DEPOSIT_PAID\", \"approval_state\": \"AUTONOMOUS\", \"brand\": \"{{2.fields.Brand}}\", \"environment\": \"{{2.fields.Environment}}\", \"destination\": \"Airtable Bookings\"}"
              },
              "metadata": { "designer": { "x": 1000, "y": 0 } }
            }
          ]
        }
      ]
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": true,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    },
    "zone": "us2.make.com",
    "notes": "REBINDING REQUIRED: Airtable connection on modules 2 and 4. PLACEHOLDERS: replace PASTE_SLACK_ALERTS_WEBHOOK_URL_HERE (module 5), PASTE_AUDIT_LOGGER_WEBHOOK_URL_HERE (module 6). STRIPE SETUP: register webhook URL (Module 1) in Stripe Developers → Webhooks → Add endpoint, event: payment_intent.succeeded. Stripe metadata must include booking_id. Router filter: event=payment_intent.succeeded AND booking found AND not DEPOSIT_PAID AND not Sandbox."
  }
}

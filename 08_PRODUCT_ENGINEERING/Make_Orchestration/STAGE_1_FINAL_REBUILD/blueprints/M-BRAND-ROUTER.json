{
  "name": "SSS-BRAND-ROUTER",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": "PASTE_HOOK_ID_HERE",
        "maxResults": 1
      },
      "mapper": {},
      "metadata": {
        "designer": { "x": 0, "y": 0 },
        "restore": {
          "parameters": {
            "hook": { "label": "SSS Brand Router Webhook" }
          }
        }
      }
    },
    {
      "id": 2,
      "module": "builtin:BasicRouter",
      "version": 1,
      "filter": {
        "name": "SAFETY GATE 1 — source_url must exist",
        "conditions": [
          [
            {
              "a": "{{1.source_url}}",
              "o": "text:exist"
            }
          ]
        ]
      },
      "parameters": {},
      "mapper": {},
      "metadata": {
        "designer": { "x": 300, "y": 0 }
      },
      "routes": [
        {
          "flow": [
            {
              "id": 3,
              "module": "gateway:CustomWebHookRespond",
              "version": 1,
              "filter": {
                "name": "Route 1 — She Said Sail (shesaidsail.com)",
                "conditions": [
                  [
                    {
                      "a": "{{1.source_url}}",
                      "o": "text:contain",
                      "b": "shesaidsail.com"
                    }
                  ]
                ]
              },
              "parameters": {},
              "mapper": {
                "status": "200",
                "body": "{\"brand\": \"SSS\", \"brand_name_full\": \"She Said Sail\", \"routing_confidence\": \"HIGH\"}"
              },
              "metadata": {
                "designer": { "x": 600, "y": -200 }
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 4,
              "module": "gateway:CustomWebHookRespond",
              "version": 1,
              "filter": {
                "name": "Route 2 — Mare Executive (mareexecutive.com)",
                "conditions": [
                  [
                    {
                      "a": "{{1.source_url}}",
                      "o": "text:contain",
                      "b": "mareexecutive.com"
                    }
                  ]
                ]
              },
              "parameters": {},
              "mapper": {
                "status": "200",
                "body": "{\"brand\": \"ME\", \"brand_name_full\": \"Mare Executive\", \"routing_confidence\": \"HIGH\"}"
              },
              "metadata": {
                "designer": { "x": 600, "y": 0 }
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 5,
              "module": "http:ActionSendData",
              "version": 3,
              "filter": {
                "name": "Route 3 — UNKNOWN (neither SSS nor ME)",
                "conditions": [
                  [
                    {
                      "a": "{{1.source_url}}",
                      "o": "text:notContain",
                      "b": "shesaidsail.com"
                    },
                    {
                      "a": "{{1.source_url}}",
                      "o": "text:notContain",
                      "b": "mareexecutive.com"
                    }
                  ]
                ]
              },
              "parameters": { "handleErrors": false, "useNewZLibDeCompress": true },
              "mapper": {
                "url": "PASTE_OPS_LOGGER_ALERTER_WEBHOOK_URL_HERE",
                "method": "POST",
                "headers": [{ "name": "Content-Type", "value": "application/json" }],
                "body": "{\"triggering_event\": \"Brand Router — UNKNOWN classification\", \"source_data\": \"Source URL: {{1.source_url}}\", \"output\": \"Brand could not be classified. Manual action required.\", \"approval_state\": \"PENDING_HUMAN\", \"brand\": \"UNKNOWN\", \"city\": \"Unknown\", \"environment\": \"Production\", \"destination\": \"Slack #sss-ops-alerts\", \"alert_type\": \"OPS\", \"severity\": \"WARNING\", \"title\": \"Brand Classification UNKNOWN — Manual Action Required\", \"body\": \"Inbound request from {{1.source_url}} could not be classified as SSS or ME. Please set Brand field manually in Airtable.\", \"booking_id\": \"{{ifempty(1.request_record_id; \"UNKNOWN\")}}\"}"
              },
              "metadata": {
                "designer": { "x": 600, "y": 200 }
              }
            },
            {
              "id": 6,
              "module": "gateway:CustomWebHookRespond",
              "version": 1,
              "parameters": {},
              "mapper": {
                "status": "200",
                "body": "{\"brand\": \"UNKNOWN\", \"brand_name_full\": \"Unknown\", \"routing_confidence\": \"LOW\"}"
              },
              "metadata": {
                "designer": { "x": 900, "y": 200 }
              }
            }
          ]
        }
      ]
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 1,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    },
    "zone": "us2.make.com",
    "notes": "=== MANUAL ACTION REQUIRED === After import: (1) Replace PASTE_OPS_LOGGER_ALERTER_WEBHOOK_URL_HERE in module 5 with the actual webhook URL from SSS-OPS-LOGGER-ALERTER. (2) Copy THIS scenario's webhook URL from module 1 — paste it into PASTE_BRAND_ROUTER_WEBHOOK_URL_HERE in M-LEAD-INTAKE. ROUTING LOGIC: source_url contains shesaidsail.com → brand=SSS (HIGH confidence). source_url contains mareexecutive.com → brand=ME (HIGH confidence). Neither → brand=UNKNOWN (LOW confidence) + OPS-LOGGER-ALERTER WARNING alert. RESPONSE FORMAT: Always returns JSON: {brand, brand_name_full, routing_confidence}. WebhookRespond is inside each route — exactly one fires per execution. This scenario is called SYNCHRONOUSLY from M-LEAD-INTAKE. Import M-OPS-LOGGER-ALERTER first."
  }
}

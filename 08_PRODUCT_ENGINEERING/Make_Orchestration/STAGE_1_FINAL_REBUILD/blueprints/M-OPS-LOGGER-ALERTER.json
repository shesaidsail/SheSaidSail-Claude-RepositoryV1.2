{
  "name": "SSS-OPS-LOGGER-ALERTER",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": "PASTE_HOOK_ID_HERE",
        "maxResults": 1
      },
      "mapper": {},
      "metadata": {
        "designer": { "x": 0, "y": 0 },
        "restore": {
          "parameters": {
            "hook": { "label": "SSS Ops Logger Alerter Webhook" }
          }
        }
      }
    },
    {
      "id": 2,
      "module": "airtable:ActionCreateRecord",
      "version": 3,
      "filter": {
        "name": "SAFETY GATE 1 — triggering_event or environment must be present",
        "conditions": [
          [
            {
              "a": "{{ifempty(1.triggering_event; 1.environment)}}",
              "o": "text:exist"
            }
          ]
        ]
      },
      "parameters": {
        "base": "appdZ49WqgjRXxA1R",
        "table": "tblrMpTfMk8q1eNHp"
      },
      "mapper": {
        "fields": {
          "Timestamp": "{{formatDate(now; \"YYYY-MM-DDTHH:mm:ssZ\")}}",
          "Triggering_Event": "{{1.triggering_event}}",
          "Source_Data": "{{1.source_data}}",
          "Output": "{{1.output}}",
          "Approval_State": "{{ifempty(1.approval_state; \"AUTONOMOUS\")}}",
          "Reviewed_By": "{{1.reviewed_by}}",
          "Rollback_Linkage": "{{1.rollback_linkage}}",
          "Brand": "{{ifempty(1.brand; \"SSS\")}}",
          "City": "{{1.city}}",
          "Environment": "{{ifempty(1.environment; \"Production\")}}",
          "Model_Version": "{{1.model_version}}",
          "AI_Confidence_Score": "{{1.ai_confidence_score}}",
          "Destination": "{{1.destination}}"
        }
      },
      "metadata": {
        "designer": { "x": 300, "y": 0 },
        "restore": {
          "parameters": {
            "base": { "label": "She Said Sail" },
            "table": { "label": "Audit Log" }
          }
        }
      }
    },
    {
      "id": 3,
      "module": "builtin:BasicRouter",
      "version": 1,
      "filter": {
        "name": "SAFETY GATE 2 — Only route to Slack if alert_type is provided",
        "conditions": [
          [
            {
              "a": "{{1.alert_type}}",
              "o": "text:exist"
            }
          ]
        ]
      },
      "parameters": {},
      "mapper": {},
      "metadata": {
        "designer": { "x": 600, "y": 0 }
      },
      "routes": [
        {
          "flow": [
            {
              "id": 4,
              "module": "slack:ActionSendMessage",
              "version": 4,
              "filter": {
                "name": "Route 1 — EMERGENCY",
                "conditions": [
                  [
                    {
                      "a": "{{1.alert_type}}",
                      "o": "text:equal",
                      "b": "EMERGENCY"
                    }
                  ]
                ]
              },
              "parameters": {
                "account": "PASTE_SLACK_CONNECTION_ID_HERE"
              },
              "mapper": {
                "channel": "#sss-emergency-ops",
                "text": "🚨 *EMERGENCY ALERT* — {{ifempty(1.booking_id; \"NO-ID\")}} — {{ifempty(1.city; \"—\")}} — {{formatDate(now; \"YYYY-MM-DD HH:mm\")}} UTC\n*Type:* {{ifempty(1.title; \"Unspecified Emergency\")}}\n*Details:* {{ifempty(1.body; \"No details\")}}\n*Brand:* {{ifempty(1.brand; \"SSS\")}}\n*Status:* AWAITING FOUNDER CLEARANCE\n*Automations:* PAUSED IMMEDIATELY\n*Audit Log Record:* {{2.id}}"
              },
              "metadata": {
                "designer": { "x": 900, "y": -250 },
                "restore": {
                  "parameters": {
                    "account": { "label": "SSS Slack" }
                  }
                }
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 5,
              "module": "slack:ActionSendMessage",
              "version": 4,
              "filter": {
                "name": "Route 2 — LEAD",
                "conditions": [
                  [
                    {
                      "a": "{{1.alert_type}}",
                      "o": "text:equal",
                      "b": "LEAD"
                    }
                  ]
                ]
              },
              "parameters": {
                "account": "PASTE_SLACK_CONNECTION_ID_HERE"
              },
              "mapper": {
                "channel": "#sss-lead-intake",
                "text": "🎯 *New {{ifempty(1.brand; \"SSS\")}} Lead*\n*Name:* {{ifempty(1.lead_name; \"—\")}}\n*Occasion:* {{ifempty(1.occasion; \"—\")}}\n*Date:* {{ifempty(1.preferred_date; \"—\")}}\n*Guests:* {{ifempty(1.guest_count; \"—\")}}\n*City:* {{ifempty(1.city; \"—\")}}\n*Source:* {{ifempty(1.source; \"—\")}}\n*Audit Log:* {{2.id}} | _{{formatDate(now; \"YYYY-MM-DD HH:mm\")}} UTC_"
              },
              "metadata": {
                "designer": { "x": 900, "y": 0 },
                "restore": {
                  "parameters": {
                    "account": { "label": "SSS Slack" }
                  }
                }
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 6,
              "module": "slack:ActionSendMessage",
              "version": 4,
              "filter": {
                "name": "Route 3 — OPS and all other alert types",
                "conditions": [
                  [
                    {
                      "a": "{{1.alert_type}}",
                      "o": "text:notEqual",
                      "b": "EMERGENCY"
                    },
                    {
                      "a": "{{1.alert_type}}",
                      "o": "text:notEqual",
                      "b": "LEAD"
                    }
                  ]
                ]
              },
              "parameters": {
                "account": "PASTE_SLACK_CONNECTION_ID_HERE"
              },
              "mapper": {
                "channel": "#sss-ops-alerts",
                "text": "{{if(1.severity = \"CRITICAL\"; \"🔴\"; if(1.severity = \"WARNING\"; \"🟡\"; \"🟢\"))}} *{{ifempty(1.title; \"Ops Update\")}}*\n{{ifempty(1.body; \"No details provided\")}}\n*Booking:* {{ifempty(1.booking_id; \"—\")}} | *City:* {{ifempty(1.city; \"—\")}} | *Brand:* {{ifempty(1.brand; \"SSS\")}}\n*Audit Log:* {{2.id}} | _{{formatDate(now; \"YYYY-MM-DD HH:mm\")}} UTC_"
              },
              "metadata": {
                "designer": { "x": 900, "y": 250 },
                "restore": {
                  "parameters": {
                    "account": { "label": "SSS Slack" }
                  }
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 1,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": true,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    },
    "zone": "us2.make.com",
    "notes": "=== MANUAL ACTION REQUIRED === After import: (1) Rebind Airtable connection on module 2 to SSS PAT. Base = appdZ49WqgjRXxA1R, Table = Audit Log (tblrMpTfMk8q1eNHp). (2) Rebind Slack OAuth connection on modules 4, 5, 6. Bind to SSS Slack workspace. Add Make bot to #sss-emergency-ops, #sss-lead-intake, #sss-ops-alerts before activating. (3) Copy the webhook URL from module 1 after import — ALL other scenarios call this endpoint. Paste into every PASTE_OPS_LOGGER_ALERTER_WEBHOOK_URL_HERE placeholder across all other scenarios. PAYLOAD SCHEMA: Send {triggering_event, source_data, output, approval_state, brand, city, environment, destination} for log-only. Add {alert_type, severity, title, body, booking_id} for log + Slack alert. alert_type values: EMERGENCY → #sss-emergency-ops, LEAD → #sss-lead-intake, OPS/other → #sss-ops-alerts. MERGED FROM: M-AUDIT-LOGGER + M-SLACK-ALERTS."
  }
}

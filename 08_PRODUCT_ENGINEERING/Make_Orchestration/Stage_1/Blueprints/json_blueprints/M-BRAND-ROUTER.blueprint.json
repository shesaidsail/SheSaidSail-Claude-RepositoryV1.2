{
  "name": "M-BRAND-ROUTER — Brand Classification and Routing",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": "RECONNECT_WEBHOOK_BRAND_ROUTER",
        "maxResults": 1
      },
      "mapper": {},
      "metadata": {
        "designer": { "x": 0, "y": 0 },
        "restore": {
          "parameters": {
            "hook": {
              "label": "M-BRAND-ROUTER Inbound Webhook — reconnect after import"
            }
          }
        },
        "expect": [
          { "name": "request_id", "type": "text", "label": "Airtable Request Record ID" },
          { "name": "lead_name", "type": "text", "label": "Lead Full Name" },
          { "name": "lead_email", "type": "text", "label": "Lead Email" },
          { "name": "inquiry_text", "type": "text", "label": "Full Inquiry Text" },
          { "name": "source_url", "type": "text", "label": "Form Source URL" },
          { "name": "environment", "type": "text", "label": "Environment (Production/Sandbox/Development)" },
          { "name": "idempotency_key", "type": "text", "label": "Idempotency Key" }
        ]
      }
    },
    {
      "id": 2,
      "module": "builtin:BasicRouter",
      "version": 1,
      "parameters": {},
      "mapper": {},
      "metadata": {
        "designer": { "x": 300, "y": 0 },
        "_note": "Guard: route production vs sandbox"
      },
      "routes": [
        {
          "label": "Production — proceed",
          "filter": {
            "name": "Production environment only",
            "conditions": [
              [
                {
                  "a": "{{1.environment}}",
                  "b": "Production",
                  "o": "text:equal"
                }
              ]
            ]
          },
          "flow": [
            {
              "id": 3,
              "module": "anthropic:ActionCreateMessage",
              "version": 1,
              "parameters": {
                "__IMTCONN__": null
              },
              "mapper": {
                "model": "claude-sonnet-4-20250514",
                "max_tokens": 600,
                "temperature": 0.4,
                "system": "You are a brand classification agent for She Said Sail (SSS) and Mare Executive (ME). SSS serves luxury social charter clients in Miami and Fort Lauderdale. ME serves executive/corporate clients. Analyze the inquiry and return a JSON object with: {\"brand\": \"SSS\" or \"ME\" or \"AMBIGUOUS\", \"confidence\": 0-100, \"reason\": \"one sentence\"}. Return only valid JSON.",
                "messages": [
                  {
                    "role": "user",
                    "content": "Classify this inquiry. Lead name: {{1.lead_name}}. Inquiry: {{1.inquiry_text}}. Source URL: {{1.source_url}}. Return JSON only."
                  }
                ]
              },
              "metadata": {
                "designer": { "x": 600, "y": -75 },
                "restore": {
                  "parameters": {
                    "__IMTCONN__": {
                      "label": "RECONNECT_CLAUDE_API_KEY — Anthropic Claude API connection"
                    }
                  }
                }
              }
            },
            {
              "id": 4,
              "module": "json:ParseJSON",
              "version": 1,
              "parameters": {
                "type": ""
              },
              "mapper": {
                "json": "{{3.content[].text}}"
              },
              "metadata": {
                "designer": { "x": 900, "y": -75 }
              }
            },
            {
              "id": 5,
              "module": "builtin:BasicRouter",
              "version": 1,
              "parameters": {},
              "mapper": {},
              "metadata": {
                "designer": { "x": 1200, "y": -75 }
              },
              "routes": [
                {
                  "label": "SSS Brand",
                  "filter": {
                    "name": "Brand is SSS",
                    "conditions": [
                      [
                        {
                          "a": "{{4.brand}}",
                          "b": "SSS",
                          "o": "text:equal"
                        }
                      ]
                    ]
                  },
                  "flow": [
                    {
                      "id": 6,
                      "module": "airtable:ActionUpdateRecord",
                      "version": 3,
                      "parameters": {
                        "__IMTCONN__": null
                      },
                      "mapper": {
                        "baseId": "appdZ49WqgjRXxA1R",
                        "tableId": "tblTlSB9CO4dTGodg",
                        "recordId": "{{1.request_id}}",
                        "fields": {
                          "Brand": "SSS",
                          "AI_Confidence_Score": "{{4.confidence}}",
                          "Agent_Status": "AI_RESPONDING",
                          "Brand_Classification_Reason": "{{4.reason}}"
                        }
                      },
                      "metadata": {
                        "designer": { "x": 1500, "y": -150 },
                        "restore": {
                          "parameters": {
                            "__IMTCONN__": {
                              "label": "RECONNECT_AIRTABLE_CONNECTION"
                            }
                          }
                        }
                      }
                    }
                  ]
                },
                {
                  "label": "ME Brand",
                  "filter": {
                    "name": "Brand is ME",
                    "conditions": [
                      [
                        {
                          "a": "{{4.brand}}",
                          "b": "ME",
                          "o": "text:equal"
                        }
                      ]
                    ]
                  },
                  "flow": [
                    {
                      "id": 7,
                      "module": "airtable:ActionUpdateRecord",
                      "version": 3,
                      "parameters": {
                        "__IMTCONN__": null
                      },
                      "mapper": {
                        "baseId": "appdZ49WqgjRXxA1R",
                        "tableId": "tblTlSB9CO4dTGodg",
                        "recordId": "{{1.request_id}}",
                        "fields": {
                          "Brand": "ME",
                          "AI_Confidence_Score": "{{4.confidence}}",
                          "Agent_Status": "AI_RESPONDING",
                          "Brand_Classification_Reason": "{{4.reason}}"
                        }
                      },
                      "metadata": {
                        "designer": { "x": 1500, "y": -75 },
                        "restore": {
                          "parameters": {
                            "__IMTCONN__": {
                              "label": "RECONNECT_AIRTABLE_CONNECTION"
                            }
                          }
                        }
                      }
                    }
                  ]
                },
                {
                  "label": "AMBIGUOUS — Escalate to Luciana",
                  "filter": {
                    "name": "Brand is AMBIGUOUS",
                    "conditions": [
                      [
                        {
                          "a": "{{4.brand}}",
                          "b": "AMBIGUOUS",
                          "o": "text:equal"
                        }
                      ]
                    ]
                  },
                  "flow": [
                    {
                      "id": 8,
                      "module": "airtable:ActionUpdateRecord",
                      "version": 3,
                      "parameters": {
                        "__IMTCONN__": null
                      },
                      "mapper": {
                        "baseId": "appdZ49WqgjRXxA1R",
                        "tableId": "tblTlSB9CO4dTGodg",
                        "recordId": "{{1.request_id}}",
                        "fields": {
                          "Brand": "AMBIGUOUS",
                          "AI_Confidence_Score": "{{4.confidence}}",
                          "Agent_Status": "HUMAN_REVIEW",
                          "Escalation_Reason": "Brand classification ambiguous: {{4.reason}}"
                        }
                      },
                      "metadata": {
                        "designer": { "x": 1500, "y": 0 },
                        "restore": {
                          "parameters": {
                            "__IMTCONN__": {
                              "label": "RECONNECT_AIRTABLE_CONNECTION"
                            }
                          }
                        }
                      }
                    },
                    {
                      "id": 9,
                      "module": "slack:CreateMessage",
                      "version": 4,
                      "parameters": {
                        "__IMTCONN__": null
                      },
                      "mapper": {
                        "channel": "#sss-ops-alerts",
                        "text": "*Brand Classification Ambiguous — Human Review Required*\nLead: {{1.lead_name}} ({{1.lead_email}})\nAI reason: {{4.reason}}\nConfidence: {{4.confidence}}%\nRequest ID: {{1.request_id}}"
                      },
                      "metadata": {
                        "designer": { "x": 1800, "y": 0 },
                        "restore": {
                          "parameters": {
                            "__IMTCONN__": {
                              "label": "RECONNECT_SLACK_CONNECTION"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              ]
            },
            {
              "id": 10,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": { "handleErrors": false, "useNewZLibDeCompression": true },
              "mapper": {
                "url": "RECONNECT_AUDIT_LOGGER_WEBHOOK_URL",
                "method": "POST",
                "headers": [{ "name": "Content-Type", "value": "application/json" }],
                "body": "{\"scenario_id\":\"M-BRAND-ROUTER\",\"action_type\":\"BRAND_CLASSIFICATION\",\"brand\":\"{{4.brand}}\",\"request_id\":\"{{1.request_id}}\",\"actor\":\"AI\",\"autonomy_tier\":\"A\",\"prompt_version\":\"SSS_BRAND_ROUTER_V1\",\"ai_confidence_score\":\"{{4.confidence}}\",\"environment\":\"{{1.environment}}\",\"idempotency_key\":\"{{1.idempotency_key}}\",\"payload_summary\":\"Brand classified as {{4.brand}} for {{1.lead_name}}\",\"outcome\":\"SUCCESS\"}"
              },
              "metadata": {
                "designer": { "x": 2100, "y": -75 },
                "restore": {
                  "_note": "HTTP KEPT — inter-scenario webhook call to M-AUDIT-LOGGER sink."
                }
              }
            }
          ]
        },
        {
          "label": "Sandbox/Dev — skip processing",
          "filter": {
            "name": "Non-production environment",
            "conditions": [
              [
                {
                  "a": "{{1.environment}}",
                  "b": "Production",
                  "o": "text:notEqual"
                }
              ]
            ]
          },
          "flow": []
        }
      ]
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "slots": null,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": { "orphans": [] },
    "zone": "us1.make.com"
  },
  "_native_first_notes": {
    "trigger": "CustomWebHook — KEPT: called by M-LEAD-INTAKE; webhook is the correct cross-scenario intake pattern",
    "module_3_anthropic": "NATIVE — anthropic:ActionCreateMessage with model claude-sonnet-4-20250514, max_tokens:600, temperature:0.4, system prompt, user message. Replaces HTTP POST to Claude API.",
    "module_4_json_parse": "NATIVE — json:ParseJSON built-in module",
    "module_6_airtable": "NATIVE — airtable:ActionUpdateRecord replaces HTTP Airtable PATCH",
    "module_7_airtable": "NATIVE — airtable:ActionUpdateRecord replaces HTTP Airtable PATCH",
    "module_8_airtable": "NATIVE — airtable:ActionUpdateRecord replaces HTTP Airtable PATCH",
    "module_9_slack": "NATIVE — slack:CreateMessage replaces HTTP Slack webhook",
    "module_10_http": "HTTP KEPT — inter-scenario call to M-AUDIT-LOGGER; no native Make cross-scenario module",
    "connection_placeholders": [
      "RECONNECT_CLAUDE_API_KEY",
      "RECONNECT_AIRTABLE_CONNECTION",
      "RECONNECT_SLACK_CONNECTION",
      "RECONNECT_AUDIT_LOGGER_WEBHOOK_URL"
    ],
    "no_secrets_included": true,
    "stage_contamination": "none"
  }
}

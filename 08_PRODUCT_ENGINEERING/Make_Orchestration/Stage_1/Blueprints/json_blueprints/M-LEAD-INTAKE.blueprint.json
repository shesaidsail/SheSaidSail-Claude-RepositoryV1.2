{
  "name": "M-LEAD-INTAKE",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": "INSERT_WEBHOOK_URL_AFTER_IMPORT",
        "maxResults": 1
      },
      "mapper": {},
      "metadata": {
        "designer": { "x": 0, "y": 0 },
        "restore": {
          "parameters": {
            "hook": { "label": "M-LEAD-INTAKE — Webflow Form Submission" }
          }
        },
        "parameters": [
          {
            "name": "hook",
            "type": "hook:gateway-webhook",
            "label": "Webhook",
            "required": true
          }
        ]
      }
    },
    {
      "id": 2,
      "module": "builtin:BasicFilter",
      "version": 1,
      "parameters": {},
      "filter": {
        "name": "Webhook Authorization Check",
        "conditions": {
          "a": "{{1.headers.authorization}}",
          "b": "Bearer {{1.body.expected_token}}",
          "o": "text:equal"
        }
      },
      "metadata": {
        "designer": { "x": 300, "y": 0 }
      }
    },
    {
      "id": 3,
      "module": "airtable:ActionSearchRecords",
      "version": 3,
      "parameters": {
        "connection": "RECONNECT_AIRTABLE_CONNECTION",
        "base": "{{1.body.base_id}}",
        "table": "tblRequests"
      },
      "mapper": {
        "filterByFormula": "AND({fldIdempotencyKey} = 'INTAKE-{{1.body.form_submission_id}}', {fldEnvironment} = 'Production')",
        "maxRecords": 1
      },
      "metadata": {
        "designer": { "x": 600, "y": 0 },
        "restore": {
          "parameters": {
            "connection": { "label": "Airtable — She Said Sail Production" }
          }
        }
      }
    },
    {
      "id": 4,
      "module": "builtin:BasicFilter",
      "version": 1,
      "parameters": {},
      "filter": {
        "name": "Idempotency — No duplicate submission",
        "conditions": {
          "a": "{{length(3.records)}}",
          "b": "0",
          "o": "number:equal"
        }
      },
      "metadata": {
        "designer": { "x": 900, "y": 0 }
      }
    },
    {
      "id": 5,
      "module": "airtable:ActionCreateRecord",
      "version": 3,
      "parameters": {
        "connection": "RECONNECT_AIRTABLE_CONNECTION",
        "base": "{{1.body.base_id}}",
        "table": "tblRequests"
      },
      "mapper": {
        "fldRecordID": "REQ-{{formatDate(now; 'YYYY')}}-{{1.body.sequence_id}}",
        "fldFirstName": "{{1.body.first_name}}",
        "fldLastName": "{{1.body.last_name}}",
        "fldEmail": "{{1.body.email}}",
        "fldPhone": "{{1.body.phone}}",
        "fldEventDate": "{{1.body.event_date}}",
        "fldGroupSize": "{{1.body.group_size}}",
        "fldEventType": "{{1.body.event_type}}",
        "fldCity": "{{1.body.city}}",
        "fldBudgetRange": "{{1.body.budget_range}}",
        "fldHearAboutUs": "{{1.body.hear_about_us}}",
        "fldAdditionalNotes": "{{1.body.additional_notes}}",
        "fldBrand": "{{upper(1.body.brand)}}",
        "fldStatus": "NEW",
        "fldAgentStatus": "AI_RESPONDING",
        "fldSourceSystem": "Make",
        "fldEnvironment": "Production",
        "fldIdempotencyKey": "INTAKE-{{1.body.form_submission_id}}",
        "fldCreatedAt": "{{now}}",
        "fldUpdatedAt": "{{now}}",
        "fldSubmissionSource": "Webflow",
        "fldRawPayload": "{{toString(1.body)}}"
      },
      "metadata": {
        "designer": { "x": 1200, "y": 0 },
        "restore": {
          "parameters": {
            "connection": { "label": "Airtable — She Said Sail Production" }
          }
        }
      }
    },
    {
      "id": 6,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {
        "handleErrors": true
      },
      "mapper": {
        "url": "INSERT_WEBHOOK_URL_AFTER_IMPORT",
        "method": "POST",
        "headers": [
          { "name": "Content-Type", "value": "application/json" },
          { "name": "Authorization", "value": "Bearer {{1.body.auth_token}}" }
        ],
        "body": {
          "record_id": "{{5.id}}",
          "brand": "{{upper(1.body.brand)}}",
          "city": "{{1.body.city}}",
          "base_id": "{{1.body.base_id}}",
          "auth_token": "{{1.body.auth_token}}"
        },
        "timeout": 30
      },
      "metadata": {
        "designer": { "x": 1500, "y": 0 },
        "parameters": [
          {
            "name": "url",
            "type": "url",
            "label": "M-BRAND-ROUTER Webhook URL",
            "required": true
          }
        ]
      }
    },
    {
      "id": 7,
      "module": "gmail:ActionSendEmail",
      "version": 1,
      "parameters": {
        "connection": "RECONNECT_GMAIL_CONNECTION"
      },
      "mapper": {
        "to": "{{1.body.email}}",
        "from": "hello@shesaidsail.com",
        "subject": "{{if(upper(1.body.brand) = 'SSS'; \"We received your inquiry — She Said Sail 🌊\"; \"We received your inquiry — Mare Executive\")}}",
        "body": "{{if(upper(1.body.brand) = 'SSS'; \"Hi {{1.body.first_name}},\\n\\nThank you for reaching out to She Said Sail! We've received your charter inquiry and someone from our team will be in touch shortly to discuss availability and details.\\n\\nWarm regards,\\nThe She Said Sail Team\"; \"Hi {{1.body.first_name}},\\n\\nThank you for contacting Mare Executive. We've received your inquiry and our team will reach out shortly to discuss your experience.\\n\\nWith warmth,\\nMare Executive\")}}",
        "isHtml": false
      },
      "metadata": {
        "designer": { "x": 1800, "y": -150 },
        "restore": {
          "parameters": {
            "connection": { "label": "Gmail — hello@shesaidsail.com" }
          }
        }
      }
    },
    {
      "id": 8,
      "module": "slack:CreateMessage",
      "version": 2,
      "parameters": {
        "connection": "RECONNECT_SLACK_CONNECTION"
      },
      "mapper": {
        "channel": "#sss-ops-alerts",
        "text": ":wave: *New Lead — {{upper(1.body.brand)}}*\nName: {{1.body.first_name}} {{1.body.last_name}}\nEmail: {{1.body.email}}\nCity: {{1.body.city}}\nEvent Date: {{1.body.event_date}}\nGroup Size: {{1.body.group_size}}\nEvent Type: {{1.body.event_type}}\nAirtable Record: {{5.id}}\nCreated: {{formatDate(now; 'YYYY-MM-DD HH:mm')}} UTC"
      },
      "metadata": {
        "designer": { "x": 1800, "y": 150 },
        "restore": {
          "parameters": {
            "connection": { "label": "Slack — She Said Sail Workspace" }
          }
        }
      }
    },
    {
      "id": 9,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {
        "handleErrors": true
      },
      "mapper": {
        "url": "INSERT_WEBHOOK_URL_AFTER_IMPORT",
        "method": "POST",
        "headers": [
          { "name": "Content-Type", "value": "application/json" },
          { "name": "Authorization", "value": "Bearer {{1.body.auth_token}}" }
        ],
        "body": {
          "scenario_name": "M-LEAD-INTAKE",
          "action": "LEAD_CREATED",
          "actor_type": "AUTOMATION",
          "actor_id": "M-LEAD-INTAKE",
          "target_table": "Requests",
          "target_record_id": "{{5.id}}",
          "autonomy_tier": "A",
          "brand": "{{upper(1.body.brand)}}",
          "city": "{{1.body.city}}",
          "base_id": "{{1.body.base_id}}",
          "idempotency_key": "AUDIT-INTAKE-{{1.body.form_submission_id}}",
          "outcome_status": "SUCCESS",
          "output_summary": "Request record created and auto-reply sent",
          "destination": "Requests table + Gmail + Slack"
        },
        "timeout": 30
      },
      "metadata": {
        "designer": { "x": 2100, "y": 0 },
        "parameters": [
          {
            "name": "url",
            "type": "url",
            "label": "M-AUDIT-LOGGER Webhook URL",
            "required": true
          }
        ]
      }
    },
    {
      "id": 10,
      "module": "builtin:ErrorHandler",
      "version": 1,
      "parameters": {},
      "mapper": {},
      "metadata": {
        "designer": { "x": 600, "y": 400 }
      }
    },
    {
      "id": 11,
      "module": "airtable:ActionCreateRecord",
      "version": 3,
      "parameters": {
        "connection": "RECONNECT_AIRTABLE_CONNECTION",
        "base": "{{1.body.base_id}}",
        "table": "tblAutomationFailures"
      },
      "mapper": {
        "fldScenarioName": "M-LEAD-INTAKE",
        "fldErrorMessage": "{{error.message}}",
        "fldErrorCode": "{{error.code}}",
        "fldFailedAt": "{{now}}",
        "fldEnvironment": "Production",
        "fldPayload": "{{toString(1.body)}}",
        "fldRetryCount": "1",
        "fldStatus": "OPEN"
      },
      "metadata": {
        "designer": { "x": 900, "y": 400 },
        "restore": {
          "parameters": {
            "connection": { "label": "Airtable — She Said Sail Production" }
          }
        }
      }
    },
    {
      "id": 12,
      "module": "slack:CreateMessage",
      "version": 2,
      "parameters": {
        "connection": "RECONNECT_SLACK_CONNECTION"
      },
      "mapper": {
        "channel": "#sss-ops-alerts",
        "text": ":red_circle: *M-LEAD-INTAKE FAILURE*\nError: {{error.message}}\nSubmission ID: {{1.body.form_submission_id}}\nEmail: {{1.body.email}}\nTimestamp: {{formatDate(now; 'YYYY-MM-DD HH:mm:ss')}} UTC\nAction: Review Automation Failures in Airtable."
      },
      "metadata": {
        "designer": { "x": 1200, "y": 400 },
        "restore": {
          "parameters": {
            "connection": { "label": "Slack — She Said Sail Workspace" }
          }
        }
      }
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 4,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": true,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    },
    "zone": "us1.make.com"
  }
}

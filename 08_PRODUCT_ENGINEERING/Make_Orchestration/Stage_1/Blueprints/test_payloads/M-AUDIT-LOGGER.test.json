{
  "_comment": "M-AUDIT-LOGGER test payloads — POST any of the objects in 'scenarios' to the webhook URL. Each represents a distinct test case. See M-AUDIT-LOGGER.spec.md § Test Steps for the full test procedure.",
  "webhook_placeholder": "https://hook.us1.make.com/REPLACE_WITH_YOUR_HOOK_ID",
  "scenarios": {
    "1_standard_audit_event": {
      "_description": "Happy-path test: write a standard audit event. Expect a new Airtable record in tblrMpTfMk8q1eNHp.",
      "scenario_id": "M-BRAND-ROUTER",
      "event_type": "BRAND_ROUTED",
      "brand": "SSS",
      "record_id": "",
      "table_name": "",
      "action": "ROUTED_TO_LEAD_INTAKE",
      "actor": "make-automation",
      "timestamp": "2026-05-16T10:00:00Z",
      "payload": {
        "source": "webflow-form",
        "lead_data": {
          "first_name": "Jane",
          "last_name": "Doe",
          "email": "jane.doe@example.com",
          "phone": "+1-555-123-4567",
          "preferred_dates": "2026-08-01 to 2026-08-08",
          "yacht_interest": "Sunseeker 76",
          "group_size": 6,
          "message": "Interested in a week-long charter in the BVI."
        }
      },
      "environment": "test",
      "idempotency_key": "M-BRAND-ROUTER-BRAND_ROUTED-TEST-20260516-100000"

    "2_idempotency_duplicate": {
      "_description": "Duplicate key test: POST identical idempotency_key as scenario 1. Expect NO new Airtable record (idempotency check blocks write). Scenario should still return 200.",
      "scenario_id": "M-BRAND-ROUTER",
      "event_type": "BRAND_ROUTED",
      "brand": "SSS",
      "record_id": "",
      "table_name": "",
      "action": "ROUTED_TO_LEAD_INTAKE",

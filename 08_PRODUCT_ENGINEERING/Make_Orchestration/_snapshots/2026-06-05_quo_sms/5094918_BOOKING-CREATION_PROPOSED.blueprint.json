ing:6px 0;\">{{1.Experience}}</td></tr><tr><td style=\"color:#666666;font-size:14px;padding:6px 0;\">Preferred Date</td><td style=\"color:#0a2342;font-size:14px;font-weight:bold;padding:6px 0;\">{{formatDate(1.`Preferred Date`; \"MMM D, YYYY\")}}</td></tr><tr><td style=\"color:#666666;font-size:14px;padding:6px 0;\">Guests</td><td style=\"color:#0a2342;font-size:14px;font-weight:bold;padding:6px 0;\">{{1.`Guest Count`}}</td></tr></table></td></tr></table></td></tr><tr><td align=\"center\" style=\"padding:40px;\"><a href=\"{{6.url}}\" style=\"background-color:#c9a84c;color:#0a2342;font-size:16px;font-weight:bold;text-decoration:none;padding:16px 40px;border-radius:4px;letter-spacing:1px;display:inline-block;\">PAY DEPOSIT NOW</a><p style=\"color:#999999;font-size:12px;margin:16px 0 0 0;\">This link expires in 24 hours.</p></td></tr><tr><td style=\"padding:0 40px 40px 40px;\"><p style=\"color:#333333;font-size:15px;line-height:1.8;margin:0;\">Questions? Just reply to this email — we're here.<br><br>Warmly,<br><strong style=\"color:#0a2342;\">The {{if(1.Brand = \"She Said Sail\"; \"She Said Sail\"; \"Mare Executive\")}} Team</strong></p></td></tr><tr><td align=\"center\" style=\"background-color:#0a2342;padding:24px 40px;\"><p style=\"color:#c9a84c;font-size:12px;letter-spacing:1px;margin:0;\">hello@shesaidsail.com</p><p style=\"color:#ffffff;font-size:11px;margin:8px 0 0 0;opacity:0.6;\">© 2025 She Said Sail. All rights reserved.</p></td></tr></table></td></tr></table></body></html>", "subject": "Your {{if(1.Brand = \"She Said Sail\"; \"She Said Sail\"; \"Mare Executive\")}} experience is ready to book, {{1.`First Name`}}", "bodyType": "rawHtml" },

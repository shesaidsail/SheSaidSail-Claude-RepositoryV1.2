# ─────────────────────────────────────────────────────────────────────────────
# Weather Market Edge Tracker — environment variables
#
# SETUP:  Copy this file to .env and fill in your real credentials.
#         NEVER paste credentials into source code or commit .env to git.
#
#   cp .env.example .env
#   nano .env   # paste your values
# ─────────────────────────────────────────────────────────────────────────────

# Kalshi REST API credentials
# Get these from:  https://kalshi.com/account/api-credentials
KALSHI_API_KEY=
KALSHI_API_SECRET=

# "demo" uses the demo sandbox (https://demo-api.kalshi.co)
# "prod" uses the live environment (https://trading.kalshi.com)
KALSHI_ENV=demo

# ─────────────────────────────────────────────────────────────────────────────
# Make.com webhook alerts (→ Quo / SMS / Slack / email)
# Get webhook URL from: Make.com → New Scenario → Custom Webhook trigger
# ─────────────────────────────────────────────────────────────────────────────
MAKE_ALERT_WEBHOOK_URL=

# Set to "false" to silence all alerts without removing the URL
ALERTS_ENABLED=true

# Minimum edge in cents to trigger an alert  (default: 10)
MIN_ALERT_EDGE_CENTS=10

# Minimum confidence level: LOW | MEDIUM | HIGH | VERY_HIGH
MIN_ALERT_CONFIDENCE=MEDIUM

# Suppress duplicate alerts for the same station+threshold+side (minutes)
ALERT_COOLDOWN_MINUTES=30

# Optional: local dashboard URL included in webhook payload
DASHBOARD_URL=http://localhost:8501

# ─────────────────────────────────────────────────────────────────────────────
# Paper trading (always-on simulation — no real money)
# ─────────────────────────────────────────────────────────────────────────────

# Master switch — set to "false" to pause all auto paper trading
PAPER_TRADING_ENABLED=true

# Starting bankroll in dollars (used on first run or after reset)
PAPER_STARTING_BANKROLL=1000

# Minimum edge in cents to enter a paper trade
PAPER_MIN_EDGE_CENTS=10

# Minimum confidence level to enter a paper trade: LOW | MEDIUM | HIGH | VERY_HIGH
PAPER_MIN_CONFIDENCE=MEDIUM

# ─── Paper trade alerts (via same MAKE_ALERT_WEBHOOK_URL) ─────────────────────
# Master switch for paper trade alerts (independent of ALERTS_ENABLED)
PAPER_ALERTS_ENABLED=true

# Alert when a paper trade is opened
PAPER_ALERT_OPEN_TRADES=true

# Alert when a paper trade settles with P&L
PAPER_ALERT_SETTLEMENTS=true

# Send end-of-day summary alert (~23:50 UTC)
PAPER_ALERT_DAILY_SUMMARY=true

# Suppress duplicate paper alerts for same station+threshold+side (minutes)
PAPER_ALERT_COOLDOWN_MINUTES=30

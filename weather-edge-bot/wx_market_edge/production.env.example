# ── Weather Market Edge Bot — Production Environment Template ──────────────
# Copy to .env and fill in your values.
# NEVER commit .env to git.

# ── Kalshi API (read-only market data) ────────────────────────────────────
KALSHI_API_KEY=your_kalshi_api_key_here
KALSHI_API_SECRET=your_kalshi_api_secret_here

# ── Make.com webhook (optional: send trade alerts via Make → Quo/SMS) ─────
MAKE_ALERT_WEBHOOK_URL=https://hook.us1.make.com/your_webhook_id_here

# ── Paper trading controls ─────────────────────────────────────────────────
PAPER_TRADING_ENABLED=true
PAPER_ALERTS_ENABLED=true
PAPER_ALERT_OPEN_TRADES=true
PAPER_ALERT_SETTLEMENTS=true
PAPER_ALERT_DAILY_SUMMARY=true
PAPER_STARTING_BANKROLL=1000

# ── Fee and edge thresholds ────────────────────────────────────────────────
KALSHI_SETTLEMENT_FEE_PCT=3.0   # Kalshi's settlement fee (% of profit on wins)
MIN_NET_EDGE=3.0                 # Minimum net edge after fees to open a trade (¢)
MIN_EDGE=5.0                     # Minimum gross edge to flag a signal (¢)
MAX_SPREAD=8.0                   # Maximum bid/ask spread to accept (¢)
DEFAULT_ORDER_TYPE=TAKER         # TAKER (market order) or MAKER (limit at mid)

# ── Risk management ────────────────────────────────────────────────────────
MAX_DAILY_LOSS_PCT=0.05          # 5% daily loss limit — halts new trades for the day
MAX_WEEKLY_LOSS_PCT=0.10         # 10% weekly loss limit — halts new trades for the week
TRADE_VOID_AFTER_DAYS=7          # Auto-void OPEN trades with no settlement after N days
VOLATILITY_SCALE_LOOKBACK=20     # Number of recent trades for volatility scaling
VOLATILITY_SCALE_THRESHOLD=2.0   # std/|mean| ratio above which sizing is reduced

# ── Streamlit dashboard ────────────────────────────────────────────────────
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
